# Copy this file to .env.local when the API is not on localhost:4000
# (for example, when the backend is deployed somewhere else).
# The frontend works without this — it defaults to http://localhost:4000.
# Do NOT commit a real .env file, and never put real credentials in the repo.

# Backend API base URL used by the shop, checkout and admin pages.
NEXT_PUBLIC_API_URL=http://localhost:4000
